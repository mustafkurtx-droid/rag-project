# Absolute paths are recommended for MCP clients with different working directories.
FINRAG_DATA_DIR=./data
FINRAG_ALLOWED_PDF_DIR=./data/inbox
FINRAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base
FINRAG_EMBEDDING_DEVICE=cpu
# Set true if the Xet download endpoint is unreachable; uses standard HTTPS.
FINRAG_EMBEDDING_DISABLE_XET=false
# Enable only after the full E5 model has been downloaded successfully.
FINRAG_EMBEDDING_LOCAL_FILES_ONLY=false
FINRAG_CHUNK_TOKENS=384
FINRAG_MARKER_DEVICE=cpu
# Optional: separate disk for model weights and Marker download temporary files.
# FINRAG_MODEL_CACHE_DIR=E:/finance-rag-cache
FINRAG_MARKER_TIMEOUT_SECONDS=1800
FINRAG_MAX_PDF_MB=200
# Set the absolute path to the isolated native OCR environment.
FINRAG_MARKER_PYTHON=C:/Users/musta/Desktop/rag project/.marker-venv/Scripts/python.exe
